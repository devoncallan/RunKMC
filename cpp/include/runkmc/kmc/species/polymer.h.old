#pragma once

#include <variant>

#include "common.h"
#include "kmc/species/unit.h"
#include "kmc/analysis/analysis.h"

enum class ChainType
{
    Sequence,
    Homopolymer
};

struct SequenceBuffer
{
    std::vector<SpeciesID> units;
    std::vector<analysis::SequenceStats> posStats;

    void reserve(size_t maxDOP)
    {
        units.reserve(maxDOP);
        posStats.reserve(NUM_BUCKETS);
    }

    void clear()
    {
        units.clear();
        std::vector<SpeciesID>().swap(units);
    }
};

struct HomopolymerBuffer
{
    SpeciesID monomer = INVALID_SPECIES_ID;
    uint32_t length = 0;
};

class Polymer
{
private:
    using Chain = std::variant<SequenceBuffer, HomopolymerBuffer>;

    PolymerState state;
    ChainType chainType;
    Chain chain;
    SpeciesID initiator;

    SequenceBuffer &sequenceBuffer()
    {
        if (!std::holds_alternative<SequenceBuffer>(chain))
            console::error("Requested sequence buffer from non-sequence polymer representation.");
        return std::get<SequenceBuffer>(chain);
    }

    const SequenceBuffer &sequenceBuffer() const
    {
        if (!std::holds_alternative<SequenceBuffer>(chain))
            console::error("Requested sequence buffer from non-sequence polymer representation.");
        return std::get<SequenceBuffer>(chain);
    }

public:
    static ChainType defaultChainType()
    {
        return registry::getNumMonomers() <= 1 ? ChainType::Homopolymer : ChainType::Sequence;
    }

    Polymer(ChainType type = ChainType::Sequence, uint32_t maxDOP = 1000)
        : state(ALIVE), chainType(type), chain(SequenceBuffer{}), initiator(INVALID_SPECIES_ID)
    {
        sequenceBuffer().reserve(maxDOP);
    };

    ~Polymer() = default;

    /***************** Modify functions ****************/

    void updateState(PolymerState ps) { state = ps; }

    ChainType getChainType() const { return chainType; }

    void addUnitToEnd(const SpeciesID unit)
    {
        sequenceBuffer().units.push_back(unit);
    }

    void initiate(const SpeciesID unit)
    {
        initiator = unit;
        state = ALIVE;
    }

    void removeUnitFromEnd()
    {
        auto &sequence = sequenceBuffer().units;
        if (sequence.empty())
            console::error("Trying to remove unit from empty polymer.");
        if (getDegreeOfPolymerization() <= 1)
            console::error("Trying to remove last unit from polymer.");

        sequence.pop_back();
    }

    void clearSequence()
    {
        sequenceBuffer().clear();
    }

    /***************** State functions *****************/
    bool isUninitiated() const { return state == PolymerState::UNINITIATED; }

    bool isAlive() const { return state == PolymerState::ALIVE; }

    size_t getDegreeOfPolymerization() const { return sequenceBuffer().units.size(); }

    bool endGroupIs(const std::vector<SpeciesID> &endGroup) const
    {
        const auto &sequence = sequenceBuffer().units;
        if (!isAlive() || endGroup.size() > getDegreeOfPolymerization() + 1)
            return false;
        return equal(sequence.end() - endGroup.size(), sequence.end(), endGroup.begin());
    }

    bool isCompressed() const
    {
        const auto &buffer = sequenceBuffer();
        if (buffer.units.empty() && !buffer.posStats.empty())
            return true;
        return false;
    }

    std::string getSequenceString() const
    {
        if (isCompressed())
            return "";

        std::string sequenceString;
        for (const auto &id : sequenceBuffer().units)
            sequenceString += std::to_string(id) + " ";
        return sequenceString;
    }

    PolymerState getState() const { return state; }

    const std::vector<SpeciesID> &getSequence() const { return sequenceBuffer().units; }

    const std::vector<analysis::SequenceStats> &getPositionalStats() const { return sequenceBuffer().posStats; }

    /***************** Reaction functions *****************/

    void terminate()
    {
        auto &buffer = sequenceBuffer();
        buffer.posStats = analysis::calculatePositionalSequenceStats(buffer.units, NUM_BUCKETS);
        clearSequence();
    }

    void terminateByChainTransfer()
    {
        state = PolymerState::TERMINATED_CT;
        terminate();
    }

    void terminateByDisproportionation()
    {
        state = PolymerState::TERMINATED_D;
        terminate();
    }

    void terminateByCombination(Polymer *&polymer)
    {
        auto &sequence = sequenceBuffer().units;
        const auto &other = polymer->getSequence();
        sequence.insert(sequence.end(), other.rbegin(), other.rend());
        state = PolymerState::TERMINATED_C;
        terminate();
    }
};
