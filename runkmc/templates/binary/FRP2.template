parameters
    num_units = {{num_units}};
    termination_time = {{termination_time}};
    analysis_time = {{analysis_time}};
end

species
    I I     [C0]={{I_c0}}   FW={{I_FW=1.0}}   f={{I_f=0.50}}
    U R     [C0]={{R_c0=0}}   FW={{R_FW=1.0}}
    M A     [C0]={{A_c0}}   FW={{A_FW=1.0}}
    M B     [C0]={{B_c0}}   FW={{B_FW=1.0}}
    
    P P[R.A]
    P P[R.B]
    P P[A.A]
    P P[A.B]
    P P[B.A]
    P P[B.B]

    # The polymers separated by | are a subgroup of P[-.A] and P[-.B]
    P P[-.A] P[R.A]|P[A.A]|P[B.A]
    P P[-.B] P[R.B]|P[A.B]|P[B.B]
    P D report=true
end

rateconstants
    kd	    = {{kd}}

    kpAA    = {{kpAA=0.0}}
    kpAB    = {{kpAB=0.0}}
    kpBA    = {{kpBA=0.0}}
    kpBB    = {{kpBB=0.0}}

    kdAA    = {{kdAA=0.0}}
    kdAB    = {{kdAB=0.0}}
    kdBA    = {{kdBA=0.0}}
    kdBB    = {{kdBB=0.0}}

    ktdAA   = {{ktdAA=0.0}}
    ktdAB   = {{ktdAB=0.0}}
    ktdBB   = {{ktdBB=0.0}}

    ktcAA   = {{ktcAA=0.0}}
    ktcAB   = {{ktcAB=0.0}}
    ktcBB   = {{ktcBB=0.0}}
end

reactions
	# ---- Initiator decomoposition ----
    ID I -kd-> R + R
    
	# ---- Initiation ----
    IN R + A -kpAA-> P[R.A]
    IN R + B -kpBB-> P[R.B]

	# ---- Propagation ----
    PR P[-.A] + A -kpAA-> P[A.A]
    PR P[-.A] + B -kpAB-> P[A.B]
    PR P[-.B] + A -kpBA-> P[B.A]
    PR P[-.B] + B -kpBB-> P[B.B]

    # ---- Depropagation ----
    DP P[A.A] -kdAA-> P[-.A] + A
    DP P[A.B] -kdAB-> P[-.A] + B
    DP P[B.A] -kdBA-> P[-.B] + A
    DP P[B.B] -kdBB-> P[-.B] + B

	# ---- Termination by combination ----
    TC P[-.A] + P[-.A] -ktcAA-> D
    TC P[-.A] + P[-.B] -ktcAB-> D
    TC P[-.B] + P[-.B] -ktcBB-> D

	# ---- Termination by disproportionation ----
    TD P[-.A] + P[-.A] -ktdAA-> D + D
    TD P[-.A] + P[-.B] -ktdAB-> D + D
    TD P[-.B] + P[-.B] -ktdBB-> D + D
end